# Local development defaults to a loopback-only SQLite intake.
# npm run preview explicitly enables the same isolated intake for a built preview.
LEAD_MODE=local
# CIVIL_LEAD_DB=.data/civil-enquiries.sqlite

# Production stays disabled until configured. Set approval-sensitive values at build time.
# CIVIL_SITE_URL=
# CIVIL_ALLOW_INDEXING=false
# LEAD_MODE=webhook
# CIVIL_LEAD_WEBHOOK_URL=
# CIVIL_LEAD_WEBHOOK_TOKEN=
# CIVIL_LEAD_IDEMPOTENCY_SECRET=
# CIVIL_TRUSTED_IP_HEADER=

# Google Apps Script / Google Sheet intake (set LEAD_MODE=sheets)
# CIVIL_LEAD_SHEET_URL=
# CIVIL_LEAD_SHEET_TOKEN=

# Third-party scripts load only for approved configured IDs. GTM takes precedence.
# NEXT_PUBLIC_CIVIL_GTM_ID=
# NEXT_PUBLIC_CIVIL_GA4_ID=
# NEXT_PUBLIC_CIVIL_META_PIXEL_ID=
